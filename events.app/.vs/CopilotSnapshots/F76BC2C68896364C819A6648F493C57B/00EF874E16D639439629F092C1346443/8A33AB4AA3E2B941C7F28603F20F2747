<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="events.app.EventDetailPage"
             Title="Event details">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label x:Name="TitleLabel"
                   FontSize="30"
                   FontAttributes="Bold" />
            <Label x:Name="DateLocationLabel"
                   FontSize="17"
                   TextColor="#5D4E9D"
                   FontAttributes="Bold" />
            <BoxView HeightRequest="1" Color="#DDDDDD" />
            <Label Text="Description" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="DescriptionLabel"
                   FontSize="17"
                   TextColor="Gray" />
            <Label x:Name="TypeLabel" FontSize="16" />
            <Label x:Name="OrganiserLabel" FontSize="16" />
            <Label x:Name="ContactLabel" FontSize="16" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
