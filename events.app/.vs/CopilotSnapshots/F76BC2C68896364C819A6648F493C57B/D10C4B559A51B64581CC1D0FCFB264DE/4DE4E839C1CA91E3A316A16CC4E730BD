<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="events.app.ContactPage"
             Title="Contact">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Contact us"
                   FontSize="30"
                   FontAttributes="Bold" />
            <Label Text="Have a question about an event? Get in touch with us."
                   FontSize="17"
                   TextColor="Gray" />
            <BoxView HeightRequest="1" Color="#DDDDDD" />
            <Label Text="Email" FontAttributes="Bold" FontSize="18" />
            <Label Text="events@example.com" FontSize="17" />
            <Label Text="Phone" FontAttributes="Bold" FontSize="18" />
            <Label Text="+84 123 456 789" FontSize="17" />
            <Label Text="Address" FontAttributes="Bold" FontSize="18" />
            <Label Text="Ho Chi Minh City, Vietnam" FontSize="17" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
